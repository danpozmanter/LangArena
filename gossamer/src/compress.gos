impl Bench for ArithDecode {
    fn prepare(&mut self) {
        self.data = test_data(self.size)
        self.encoded = arith_encode(self.data)
    }

    fn run(&mut self, iteration_id: i64) {
        self.decoded = arith_decode(self.encoded)
        self.result = (self.result + self.decoded.len()) & helper::MASK32
    }

    fn checksum(&self) -> i64 {
        if self.decoded == self.data {
            (self.result + 100_000) & helper::MASK32
        } else {
            self.result
        }
    }
}

fn lzw_encode(input: Vec<u8>) -> Vec<u8> {
    if input.is_empty() { return #[] }

    let mut dict: Map<String, i64> = Map::new()
    for i in 0..256 {
        let mut s = String::new()
        s.push_char(i as char)
        let _ = dict.insert(s, i)
    }

    let mut next_code = 256
    let mut out: Vec<u8> = #[]

    let mut current = String::new()
    current.push_char(input[0] as char)

    for i in 1..input.len() {
        let mut next_char = String::new()
        next_char.push_char(input[i] as char)
        let candidate = current + next_char

        if dict.contains_key(candidate) {
            current = candidate
        } else {
            let code = dict.get_or(current, 0)
            out.push(((code >> 8) & 0xFF) as u8)
            out.push((code & 0xFF) as u8)

            let _ = dict.insert(candidate, next_code)
            next_code += 1
            current = next_char
        }
    }

    let code = dict.get_or(current, 0)
    out.push(((code >> 8) & 0xFF) as u8)
    out.push((code & 0xFF) as u8)
    out
}

fn lzw_decode(encoded: Vec<u8>) -> Vec<u8> {
    if encoded.is_empty() { return #[] }

    let mut dict: Vec<String> = #[]
    for i in 0..256 {
        let mut s = String::new()
        s.push_char(i as char)
        dict.push(s)
    }

    let mut out: Vec<u8> = #[]
    let mut pos = 0

    let old_code = ((encoded[pos] as i64) << 8) | (encoded[pos + 1] as i64)
    pos += 2

    let mut old_str = dict[old_code]
    for b in old_str.bytes() { out.push(b) }

    let mut next_code = 256

    while pos < encoded.len() {
        let new_code = ((encoded[pos] as i64) << 8) | (encoded[pos + 1] as i64)
        pos += 2

        let new_str = if new_code < dict.len() {
            dict[new_code]
        } else if new_code == next_code {
            old_str + old_str.substring(0, 1)
        } else {
            return #[]
        }

        for b in new_str.bytes() { out.push(b) }

        dict.push(old_str + new_str.substring(0, 1))
        next_code += 1
        old_str = new_str
    }

    out
}


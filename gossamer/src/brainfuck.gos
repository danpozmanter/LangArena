use bench::Bench
use config::Config
use helper

const CELL_MASK: i64 = 0xFF

struct Tape {
    cells: Vec<u8>
    pos: i64
}

impl Tape {
    fn new(size: i64) -> Tape { Tape { cells: #[0; size], pos: 0 } }

    fn get(&self) -> i64 { self.cells[self.pos] as i64 }

    fn add(&mut self, delta: i64) {
        self.cells[self.pos] = ((self.cells[self.pos] as i64 + delta) & CELL_MASK) as u8
    }

    fn advance(&mut self) {
        self.pos += 1
        if self.pos >= self.cells.len() { self.cells.push(0) }
    }

    fn devance(&mut self) {
        if self.pos > 0 { self.pos -= 1 }
    }
}

struct Program {
    commands: Vec<u8>
    jumps: Vec<i64>
}

impl Program {
    fn compile(text: String) -> Program {
        let mut commands: Vec<u8> = #[]
        for b in text.bytes() {
            if matches(b, b'+' | b'-' | b'>' | b'<' | b'[' | b']' | b'.' | b',') {
                commands.push(b)
            }
        }

        let mut jumps: Vec<i64> = #[0; commands.len()]
        let mut stack: Vec<i64> = #[]

        for i in 0..commands.len() {
            if commands[i] == b'[' {
                stack.push(i)
            } else if commands[i] == b']' {
                let start = stack.pop().unwrap_or(0)
                jumps[start] = i
                jumps[i] = start
            }
        }

        Program { commands: commands, jumps: jumps }
    }

    fn run(&self) -> i64 {
        let mut tape = Tape::new(30_000)
        let mut pc = 0
        let mut result: i64 = 0

        while pc < self.commands.len() {
            let cmd = self.commands[pc]
            let mut next_pc = pc + 1
            match cmd {
                b'+' => tape.add(1)
                b'-' => tape.add(-1)
                b'>' => tape.advance()
                b'<' => tape.devance()
                b'[' => if tape.get() == 0 { next_pc = self.jumps[pc] + 1 }
                b']' => if tape.get() != 0 { next_pc = self.jumps[pc] + 1 }
                b'.' => result = ((result << 2) + tape.get()) & helper::MASK32
                _ => ()
            }
            pc = next_pc
        }

        result
    }
}

pub struct BrainfuckArray {
    program: String
    warmup_program: String
    result: i64
}

impl BrainfuckArray {
    pub fn new(cfg: Config) -> BrainfuckArray {
        BrainfuckArray {
            program: cfg.str("Brainfuck::Array", "program")
            warmup_program: cfg.str("Brainfuck::Array", "warmup_program")
            result: 0
        }
    }
}

impl Bench for BrainfuckArray {
    fn warmup(&mut self, iterations: i64) {
        for _ in 0..iterations { Program::compile(self.warmup_program).run() }
    }

    fn run(&mut self, iteration_id: i64) {
        let value = Program::compile(self.program).run()
        self.result = (self.result + value) & helper::MASK32
    }

    fn checksum(&self) -> i64 { self.result }
}

enum Op {
    Dec
    Inc
    Prev
    Next
    Print
    Loop(Vec<Op>)
}

struct BrainfuckParser {
    bytes: Vec<u8>
    pos: i64
}

impl BrainfuckParser {
    fn parse(&mut self) -> Vec<Op> {
        let mut ops: Vec<Op> = #[]
        while self.pos < self.bytes.len() {
            let b = self.bytes[self.pos]
            self.pos += 1
            match b {
                b'-' => ops.push(Op::Dec)
                b'+' => ops.push(Op::Inc)
                b'<' => ops.push(Op::Prev)
                b'>' => ops.push(Op::Next)
                b'.' => ops.push(Op::Print)
                b'[' => ops.push(Op::Loop(self.parse()))
                b']' => return ops
                _ => ()
            }
        }
        ops
    }
}

pub struct BrainfuckRecursion {
    program: String
    warmup_program: String
    tape: Tape
    result: i64
}

impl BrainfuckRecursion {
    pub fn new(cfg: Config) -> BrainfuckRecursion {
        BrainfuckRecursion {
            program: cfg.str("Brainfuck::Recursion", "program")
            warmup_program: cfg.str("Brainfuck::Recursion", "warmup_program")
            tape: Tape::new(1)
            result: 0
        }
    }

    fn execute(&mut self, ops: Vec<Op>, result: i64) -> i64 {
        let mut acc = result
        for op in ops {
            let mut next_acc = acc
            match op {
                Op::Dec => self.tape.add(-1)
                Op::Inc => self.tape.add(1)
                Op::Prev => self.tape.devance()
                Op::Next => self.tape.advance()
                Op::Print => next_acc = ((acc << 2) + self.tape.get()) & helper::MASK32
                Op::Loop(inner) => {
                    let mut loop_acc = acc
                    while self.tape.get() != 0 { loop_acc = self.execute(inner, loop_acc) }
                    next_acc = loop_acc
                }
            }
            acc = next_acc
        }
        acc
    }

    fn interpret(&mut self, text: String) -> i64 {
        let mut parser = BrainfuckParser { bytes: text.as_bytes(), pos: 0 }
        let ops = parser.parse()
        self.tape = Tape::new(1)
        self.execute(ops, 0)
    }
}

impl Bench for BrainfuckRecursion {
    fn warmup(&mut self, iterations: i64) {
        for _ in 0..iterations { self.interpret(self.warmup_program) }
    }

    fn run(&mut self, iteration_id: i64) {
        let value = self.interpret(self.program)
        self.result = (self.result + value) & helper::MASK32
    }

    fn checksum(&self) -> i64 { self.result }
}

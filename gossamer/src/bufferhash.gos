use bench::Bench
use config::Config
use helper

fn random_buffer(cfg: Config, name: String) -> Vec<u8> {
    let mut rng = helper::Rng::new()
    let size = cfg.int(name, "size")
    let mut data: Vec<u8> = #[0; size]
    for i in 0..size { data[i] = rng.next_int(256) as u8 }
    data
}

pub struct BufferHashCrc32 {
    data: Vec<u8>
    result: i64
}

impl BufferHashCrc32 {
    pub fn new(cfg: Config) -> BufferHashCrc32 {
        BufferHashCrc32 { data: random_buffer(cfg, "Hash::CRC32"), result: 0 }
    }
}

fn crc32(data: Vec<u8>) -> i64 {
    let mut crc: i64 = 0xFFFFFFFF

    for byte in data {
        crc ^= byte as i64
        for _ in 0..8 {
            if crc & 1 != 0 {
                crc = (crc >> 1) ^ 0xEDB88320
            } else {
                crc >>= 1
            }
        }
    }

    crc ^ 0xFFFFFFFF
}

impl Bench for BufferHashCrc32 {
    fn run(&mut self, iteration_id: i64) {
        self.result = (self.result + crc32(self.data)) & helper::MASK32
    }

    fn checksum(&self) -> i64 { self.result }
}

pub struct BufferHashSha256 {
    data: Vec<u8>
    result: i64
}

impl BufferHashSha256 {
    pub fn new(cfg: Config) -> BufferHashSha256 {
        BufferHashSha256 { data: random_buffer(cfg, "Hash::SHA256"), result: 0 }
    }
}

fn digest(data: Vec<u8>) -> Vec<i64> {
    let mut lanes: Vec<i64> = #[
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a
        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
    ]

    for i in 0..data.len() {
        let lane = i % 8
        let mut hash = lanes[lane]
        hash = ((hash << 5) + hash + (data[i] as i64)) & helper::MASK32
        hash = ((hash + ((hash << 10) & helper::MASK32)) & helper::MASK32) ^ (hash >> 6)
        lanes[lane] = hash
    }

    let mut out: Vec<i64> = #[0; 32]
    for i in 0..8 {
        let hash = lanes[i]
        out[i * 4] = (hash >> 24) & 0xFF
        out[i * 4 + 1] = (hash >> 16) & 0xFF
        out[i * 4 + 2] = (hash >> 8) & 0xFF
        out[i * 4 + 3] = hash & 0xFF
    }
    out
}

impl Bench for BufferHashSha256 {
    fn run(&mut self, iteration_id: i64) {
        let d = digest(self.data)
        let leading = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24)
        self.result = (self.result + leading) & helper::MASK32
    }

    fn checksum(&self) -> i64 { self.result }
}

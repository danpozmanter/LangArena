use bench::Bench
use config::Config
use helper

pub enum Node {
    Number(i64)
    Variable(String)
    BinaryOp(char, Node, Node)
    Assignment(String, Node)
}

struct Parser {
    bytes: Vec<u8>
    pos: i64
}

impl Parser {
    fn new(text: String) -> Parser { Parser { bytes: text.as_bytes(), pos: 0 } }

    fn current(&self) -> u8 {
        if self.pos < self.bytes.len() { self.bytes[self.pos] } else { 0 }
    }

    fn advance(&mut self) { self.pos += 1 }

    fn skip_whitespace(&mut self) {
        while is_whitespace(self.current()) { self.advance() }
    }

    fn parse(&mut self) -> Vec<Node> {
        let mut expressions: Vec<Node> = #[]

        while self.current() != 0 {
            self.skip_whitespace()
            if self.current() == 0 { break }

            expressions.push(self.parse_expression())

            self.skip_whitespace()
            while self.current() == b'\n' {
                self.advance()
                self.skip_whitespace()
            }
        }

        expressions
    }

    fn parse_expression(&mut self) -> Node {
        let mut node = self.parse_term()
        loop {
            self.skip_whitespace()
            let c = self.current()
            if c != b'+' && c != b'-' { break }
            self.advance()
            node = Node::BinaryOp(c as char, node, self.parse_term())
        }
        node
    }

    fn parse_term(&mut self) -> Node {
        let mut node = self.parse_factor()
        loop {
            self.skip_whitespace()
            let c = self.current()
            if c != b'*' && c != b'/' && c != b'%' { break }
            self.advance()
            node = Node::BinaryOp(c as char, node, self.parse_factor())
        }
        node
    }

    fn parse_factor(&mut self) -> Node {
        self.skip_whitespace()
        let c = self.current()

        if is_digit(c) {
            return self.parse_number()
        }
        if is_letter(c) {
            return self.parse_variable()
        }
        if c == b'(' {
            self.advance()
            let node = self.parse_expression()
            self.skip_whitespace()
            if self.current() == b')' { self.advance() }
            return node
        }

        self.advance()
        Node::Number(0)
    }

    fn parse_number(&mut self) -> Node {
        let start = self.pos
        while is_digit(self.current()) { self.advance() }
        Node::Number(self.slice(start, self.pos).to_i64().unwrap_or(0))
    }

    fn parse_variable(&mut self) -> Node {
        let start = self.pos
        while is_letter(self.current()) || is_digit(self.current()) { self.advance() }
        let name = self.slice(start, self.pos)

        self.skip_whitespace()
        if self.current() == b'=' {
            self.advance()
            return Node::Assignment(name, self.parse_expression())
        }

        Node::Variable(name)
    }

    fn slice(&self, start: i64, end: i64) -> String {
        let mut out = String::with_capacity(end - start)
        for i in start..end { out.push_char(self.bytes[i] as char) }
        out
    }
}

fn is_digit(b: u8) -> bool { matches(b, b'0'..=b'9') }

fn is_letter(b: u8) -> bool { matches(b, b'a'..=b'z' | b'A'..=b'Z') }

fn is_whitespace(b: u8) -> bool { matches(b, b' ' | b'\t' | b'\n' | b'\r') }

fn generate_program(operations: i64, rng: &mut helper::Rng) -> String {
    let mut text = String::new()
    text.push_str("v0 = 1\n")

    for i in 0..10 {
        let v = i + 1
        text.push_str(format("v{} = v{} + {}\n", v, v - 1, v))
    }

    for i in 0..operations {
        let v = i + 10
        text.push_str(format("v{} = v{} + ", v, v - 1))

        match rng.next_int(10) {
            0 => text.push_str(format(
                "(v{} / 3) * 4 - {} / (3 + (18 - v{})) % v{} + 2 * ((9 - v{}) * (v{} + 7))"
                v - 1, i, v - 2, v - 3, v - 6, v - 5))
            1 => text.push_str(format("v{} + (v{} + v{}) * v{} - (v{} / v{})"
                v - 1, v - 2, v - 3, v - 4, v - 5, v - 6))
            2 => text.push_str(format("(3789 - (((v{})))) + 1", v - 7))
            3 => text.push_str(format("4/2 * (1-3) + v{}/v{}", v - 9, v - 5))
            4 => text.push_str(format("1+2+3+4+5+6+v{}", v - 1))
            5 => text.push_str(format("(99999 / v{})", v - 3))
            6 => text.push_str(format("0 + 0 - v{}", v - 8))
            7 => text.push_str(format("((((((((((v{})))))))))) * 2", v - 6))
            8 => text.push_str(format("{} * (v{}%6)%7", i, v - 1))
            _ => text.push_str(format("(1)/(0-v{}) + (v{})", v - 5, v - 7))
        }

        text.push_char('\n')
    }

    text
}

pub struct CalculatorAst {
    operations: i64
    text: String
    expressions: Vec<Node>
    result: i64
    rng: helper::Rng
}

impl CalculatorAst {
    pub fn new(cfg: Config) -> CalculatorAst {
        CalculatorAst {
            operations: cfg.int("Calculator::Ast", "operations")
            text: ""
            expressions: #[]
            result: 0
            rng: helper::Rng::new()
        }
    }

    pub fn expressions(&self) -> Vec<Node> { self.expressions }
}

impl Bench for CalculatorAst {
    fn prepare(&mut self) {
        self.text = generate_program(self.operations, &mut self.rng)
    }

    fn run(&mut self, iteration_id: i64) {
        let mut parser = Parser::new(self.text)
        self.expressions = parser.parse()
        self.result = (self.result + self.expressions.len()) & helper::MASK32

        if let Some(last) = self.expressions.last() {
            if let Node::Assignment(name, _) = last {
                self.result = (self.result + helper::checksum_str(name)) & helper::MASK32
            }
        }
    }

    fn checksum(&self) -> i64 { self.result }
}

fn magnitude(x: i64) -> i64 { if x < 0 { x *% -1 } else { x } }

fn simple_div(a: i64, b: i64) -> i64 {
    if b == 0 { return 0 }
    if (a >= 0 && b > 0) || (a < 0 && b < 0) {
        a / b
    } else {
        (magnitude(a) / magnitude(b)) *% -1
    }
}

fn simple_mod(a: i64, b: i64) -> i64 {
    if b == 0 { return 0 }
    a +% simple_div(a, b) *% b *% -1
}

struct Interpreter {
    variables: Map<String, i64>
}

impl Interpreter {
    fn evaluate(&mut self, node: Node) -> i64 {
        match node {
            Node::Number(n) => n
            Node::Variable(name) => self.variables.get_or(name, 0)
            Node::BinaryOp(op, left, right) => {
                let a = self.evaluate(left)
                let b = self.evaluate(right)
                match op {
                    '+' => a +% b
                    '-' => a +% b *% -1
                    '*' => a *% b
                    '/' => simple_div(a, b)
                    '%' => simple_mod(a, b)
                    _ => 0
                }
            }
            Node::Assignment(name, expr) => {
                let value = self.evaluate(expr)
                let _ = self.variables.insert(name, value)
                value
            }
        }
    }
}

pub struct CalculatorInterpreter {
    operations: i64
    ast: Vec<Node>
    result: i64
}

impl CalculatorInterpreter {
    pub fn new(cfg: Config) -> CalculatorInterpreter {
        CalculatorInterpreter {
            operations: cfg.int("Calculator::Interpreter", "operations")
            ast: #[]
            result: 0
        }
    }
}

impl Bench for CalculatorInterpreter {
    fn prepare(&mut self) {
        let mut rng = helper::Rng::new()
        let text = generate_program(self.operations, &mut rng)
        let mut parser = Parser::new(text)
        self.ast = parser.parse()
    }

    fn run(&mut self, iteration_id: i64) {
        let mut interpreter = Interpreter { variables: Map::new() }
        let mut value = 0
        for expression in self.ast { value = interpreter.evaluate(expression) }
        self.result = (self.result + value) & helper::MASK32
    }

    fn checksum(&self) -> i64 { self.result }
}

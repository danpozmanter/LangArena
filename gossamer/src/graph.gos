use bench::Bench
use config::Config
use helper

const UNREACHED: i64 = 2_147_483_647

struct Graph {
    vertices: i64
    adj: Vec<Vec<i64>>
}

impl Graph {
    fn generate(cfg: Config, name: String) -> Graph {
        let vertices = cfg.int(name, "vertices")
        let jumps = cfg.int(name, "jumps")
        let jump_len = cfg.int(name, "jump_len")

        let mut adj: Vec<Vec<i64>> = #[]
        for _ in 0..vertices { adj.push(#[]) }

        let mut g = Graph { vertices: vertices, adj: adj }
        for i in 1..vertices { g.add_edge(i, i - 1) }

        let mut rng = helper::Rng::new()
        for v in 0..vertices {
            for _ in 0..rng.next_int(jumps) {
                let u = v + rng.next_int(jump_len) - jump_len / 2
                if u >= 0 && u < vertices && u != v { g.add_edge(v, u) }
            }
        }
        g
    }

    fn add_edge(&mut self, u: i64, v: i64) {
        if u < self.adj.len() && v < self.adj.len() {
            self.adj[u].push(v)
            self.adj[v].push(u)
        }
    }
}

pub struct GraphBfs {
    graph: Graph
    result: i64
}

impl GraphBfs {
    pub fn new(cfg: Config) -> GraphBfs {
        GraphBfs { graph: Graph::generate(cfg, "Graph::BFS"), result: 0 }
    }

    fn shortest_path(&self, start: i64, target: i64) -> i64 {
        if start == target { return 0 }

        let mut visited: Vec<bool> = #[false; self.graph.vertices]
        let mut queue = Deque::new()

        visited[start] = true
        queue.push_back((start, 0))

        while let Some((v, dist)) = queue.pop_front() {
            for neighbor in self.graph.adj[v] {
                if neighbor == target { return dist + 1 }
                if !visited[neighbor] {
                    visited[neighbor] = true
                    queue.push_back((neighbor, dist + 1))
                }
            }
        }
        -1
    }
}

impl Bench for GraphBfs {
    fn run(&mut self, iteration_id: i64) {
        let length = self.shortest_path(0, self.graph.vertices - 1)
        self.result = (self.result + length) & helper::MASK32
    }

    fn checksum(&self) -> i64 { self.result }
}

pub struct GraphDfs {
    graph: Graph
    result: i64
}

impl GraphDfs {
    pub fn new(cfg: Config) -> GraphDfs {
        GraphDfs { graph: Graph::generate(cfg, "Graph::DFS"), result: 0 }
    }

    fn find_path(&self, start: i64, target: i64) -> i64 {
        if start == target { return 0 }

        let mut visited: Vec<bool> = #[false; self.graph.vertices]
        let mut stack: Vec<(i64, i64)> = #[(start, 0)]
        let mut best = UNREACHED

        while let Some((v, dist)) = stack.pop() {
            if visited[v] || dist >= best { continue }
            visited[v] = true

            for neighbor in self.graph.adj[v] {
                if neighbor == target {
                    if dist + 1 < best { best = dist + 1 }
                } else if !visited[neighbor] {
                    stack.push((neighbor, dist + 1))
                }
            }
        }

        if best == UNREACHED { -1 } else { best }
    }
}

impl Bench for GraphDfs {
    fn run(&mut self, iteration_id: i64) {
        let length = self.find_path(0, self.graph.vertices - 1)
        self.result = (self.result + length) & helper::MASK32
    }

    fn checksum(&self) -> i64 { self.result }
}

pub struct GraphAStar {
    graph: Graph
    result: i64
}

impl GraphAStar {
    pub fn new(cfg: Config) -> GraphAStar {
        GraphAStar { graph: Graph::generate(cfg, "Graph::AStar"), result: 0 }
    }

    fn shortest_path(&self, start: i64, target: i64) -> i64 {
        if start == target { return 0 }

        let vertices = self.graph.vertices
        let mut g_score: Vec<i64> = #[UNREACHED; vertices]
        let mut best_f: Vec<i64> = #[UNREACHED; vertices]

        g_score[start] = 0
        let f_start = target - start
        best_f[start] = f_start

        let mut open = MinHeap::new()
        open.push((f_start, start))

        while let Some((_, vertex)) = open.pop() {
            if vertex == target { return g_score[vertex] }

            for neighbor in self.graph.adj[vertex] {
                let tentative = g_score[vertex] + 1
                if tentative < g_score[neighbor] {
                    g_score[neighbor] = tentative
                    let f_new = tentative + target - neighbor
                    if f_new < best_f[neighbor] {
                        best_f[neighbor] = f_new
                        open.push((f_new, neighbor))
                    }
                }
            }
        }
        -1
    }
}

impl Bench for GraphAStar {
    fn run(&mut self, iteration_id: i64) {
        let length = self.shortest_path(0, self.graph.vertices - 1)
        self.result = (self.result + length) & helper::MASK32
    }

    fn checksum(&self) -> i64 { self.result }
}

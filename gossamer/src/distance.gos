use bench::Bench
use config::Config
use helper

const ALPHABET: String = "abcdefghij"
const NGRAM_SIZE: i64 = 4

fn generate_pairs(cfg: Config, name: String) -> Vec<(String, String)> {
    let mut rng = helper::Rng::new()
    let count = cfg.int(name, "count")
    let size = cfg.int(name, "size")

    let mut pairs: Vec<(String, String)> = #[]
    for _ in 0..count {
        let len1 = rng.next_int(size) + 4
        let len2 = rng.next_int(size) + 4

        let mut first = String::with_capacity(len1)
        for _ in 0..len1 { first.push_char(ALPHABET[rng.next_int(10)]) }

        let mut second = String::with_capacity(len2)
        for _ in 0..len2 { second.push_char(ALPHABET[rng.next_int(10)]) }

        pairs.push((first, second))
    }
    pairs
}

pub struct Jaro {
    pairs: Vec<(String, String)>
    result: i64
}

impl Jaro {
    pub fn new(cfg: Config) -> Jaro {
        Jaro { pairs: generate_pairs(cfg, "Distance::Jaro"), result: 0 }
    }
}

fn jaro(s1: String, s2: String) -> f64 {
    let a = s1.as_bytes()
    let b = s2.as_bytes()
    let len1 = a.len()
    let len2 = b.len()

    if len1 == 0 || len2 == 0 { return 0.0 }

    let longest = if len1 > len2 { len1 } else { len2 }
    let match_dist = if longest / 2 > 0 { longest / 2 - 1 } else { 0 }

    let mut hit1: Vec<bool> = #[false; len1]
    let mut hit2: Vec<bool> = #[false; len2]

    let mut hits = 0
    for i in 0..len1 {
        let start = if i > match_dist { i - match_dist } else { 0 }
        let end = if len2 - 1 < i + match_dist { len2 - 1 } else { i + match_dist }

        for j in start..=end {
            if !hit2[j] && a[i] == b[j] {
                hit1[i] = true
                hit2[j] = true
                hits += 1
                break
            }
        }
    }

    if hits == 0 { return 0.0 }

    let mut transpositions = 0
    let mut k = 0
    for i in 0..len1 {
        if hit1[i] {
            while k < len2 && !hit2[k] { k += 1 }
            if k < len2 {
                if a[i] != b[k] { transpositions += 1 }
                k += 1
            }
        }
    }
    transpositions /= 2

    let m = hits as f64
    (m / len1 as f64 + m / len2 as f64 + (m - transpositions as f64) / m) / 3.0
}

impl Bench for Jaro {
    fn run(&mut self, iteration_id: i64) {
        for (first, second) in self.pairs {
            let score = (jaro(first, second) * 1000.0) as i64
            self.result = (self.result + score) & helper::MASK32
        }
    }

    fn checksum(&self) -> i64 { self.result }
}

pub struct NGram {
    pairs: Vec<(String, String)>
    result: i64
}

impl NGram {
    pub fn new(cfg: Config) -> NGram {
        NGram { pairs: generate_pairs(cfg, "Distance::NGram"), result: 0 }
    }
}

fn ngram(s1: String, s2: String) -> f64 {
    let a = s1.as_bytes()
    let b = s2.as_bytes()
    let len1 = a.len()
    let len2 = b.len()

    if len1 < NGRAM_SIZE || len2 < NGRAM_SIZE { return 0.0 }

    let mut grams1: Map<i64, i64> = Map::new()
    for i in 0..=(len1 - NGRAM_SIZE) {
        let gram = ((a[i] as i64) << 24) | ((a[i + 1] as i64) << 16) |
        ((a[i + 2] as i64) << 8) | (a[i + 3] as i64)
        grams1.inc(gram)
    }

    let mut grams2: Map<i64, i64> = Map::new()
    let mut intersection = 0
    for i in 0..=(len2 - NGRAM_SIZE) {
        let gram = ((b[i] as i64) << 24) | ((b[i + 1] as i64) << 16) |
        ((b[i + 2] as i64) << 8) | (b[i + 3] as i64)
        let count2 = grams2.inc(gram)
        if count2 <= grams1.get_or(gram, 0) { intersection += 1 }
    }

    let total = grams1.len() + grams2.len()
    if total > 0 { intersection as f64 / total as f64 } else { 0.0 }
}

impl Bench for NGram {
    fn run(&mut self, iteration_id: i64) {
        for (first, second) in self.pairs {
            let score = (ngram(first, second) * 1000.0) as i64
            self.result = (self.result + score) & helper::MASK32
        }
    }

    fn checksum(&self) -> i64 { self.result }
}
